# Build output
/target
/.build

# The Neovim module, built from crates/den-nvim by `:Den build`.
/lua/den_native.so

# A vault's search index is rebuilt from its Markdown and belongs to the
# machine. (The fixture vault's .den/log is test data and is tracked.)
/.den/
index.sqlite

.DS_Store

# Personal working context for whoever builds Den on this machine. Never
# committed: it describes the owner's setup and habits.
/MEMORY.md

# Local tooling (preview servers, agent worktrees).
/.claude/
